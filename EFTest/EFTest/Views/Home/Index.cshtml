@model List<EFTest.Models.Student>

@{
    ViewData["Title"] = "Home Page";
}

<h1 class="display-4">@Model.Count estudante(s)</h1>

<a asp-action="Create" asp-controller="Home" class="btn btn-success mb-2">Adicionar</a>

<table class="table table-responsive table-hover table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Nome</th>
            <th>Sobrenome</th>
            <th>Data da matrícula</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var s in Model)
        {
            <tr>
                <td>@s.Id</td>
                <td>@s.FirstMidName</td>
                <td>@s.LastName</td>
                <td>@s.EnrollmentDate.ToShortDateString()</td>
                <td>
                    <form asp-controller="Home" asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@s.Id" />
                        <button type="submit" class="btn btn-danger btn-sm">Excluir</button>
                    </form>
                </td>
                <td>
                    <a asp-controller="Home" asp-action="Update" asp-route-id="@s.Id" class="btn btn-primary btn-sm">
                        Editar
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>