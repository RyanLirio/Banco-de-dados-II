@model EFTest.Models.Student

@{
    ViewData["Title"] = "Adicionar Estudante";
}

<h2>Adicionar Estudante</h2>

<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="FirstMidName"></label>
        <input asp-for="FirstMidName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="EnrollmentDate"></label>
        <input asp-for="EnrollmentDate" class="form-control" type="date" />
    </div>
    <button type="submit" class="btn btn-primary">Salvar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>